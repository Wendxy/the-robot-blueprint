---
import "../styles/global.css";
import { href } from "../lib/posts";

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  noindex?: boolean;
}
const {
  title, description = "An independent journal on robot learning, small machines, and intelligence in the physical world.",
  article = false, noindex = false,
} = Astro.props;
const displayTitle = title ? `${title} — Motion / Notes` : "Motion / Notes — An independent robotics journal";
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site) : undefined;
const pages = [["Writing", "writing/"], ["Research", "research/"], ["About", "about/"]];
---
<!doctype html>
<html lang="en-AU" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#fbfbf9" />
    <title>{displayTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content="Motion / Notes" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="Motion / Notes" href={href("rss.xml")} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={href()} aria-label="Motion / Notes home">motion <span>/</span> notes</a>
        <nav class="nav" aria-label="Primary">
          {pages.map(([label, path]) => <a href={href(path)} aria-current={Astro.url.pathname === href(path) ? "page" : undefined}>{label}</a>)}
        </nav>
      </div>
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    <footer>
      <div class="shell footer-inner">
        <span>motion / notes — an independent robotics journal</span>
        <a href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>
  </body>
</html>
