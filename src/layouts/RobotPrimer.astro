---
import Base from "./Base.astro";
import "../styles/robot-activities.css";

const { title, description } = Astro.props.frontmatter;
---

<Base {title} {description} article>
  <article class="shell reader">
    <div class="prose robot-primer"><slot /></div>
  </article>
  <script>
    import "../scripts/robot-activities";
  </script>
</Base>
